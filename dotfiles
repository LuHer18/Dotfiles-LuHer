#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

usage() {
  printf '%s\n' 'Usage: ./dotfiles setup [--select LIST] [--dry-run] [--yes] [--allow-remote-installers] [--configs-only] [--pi-merge]'
}

fail() {
  printf '[dotfiles] %s\n' "$1" >&2
  exit 1
}

read_os() {
  if [[ -n ${DOTFILES_OS:-} ]]; then
    printf '%s\n' "$DOTFILES_OS"
  else
    uname -s
  fi
}

validate_os() {
  case "$1" in
    Darwin) ;;
    Linux) ;;
    *) fail "Unsupported OS: $1" ;;
  esac
}

validate_linux_distribution() {
  local release_file=${DOTFILES_OS_RELEASE:-/etc/os-release}
  local key value distro=
  [[ -r "$release_file" ]] || fail 'Cannot identify Linux distribution'
  while IFS='=' read -r key value; do
    if [[ "$key" == ID ]]; then
      distro=${value#\"}
      distro=${distro%\"}
      break
    fi
  done < "$release_file"
  case "$distro" in
    ubuntu|debian) ;;
    *) fail "Unsupported Linux distribution: ${distro:-unknown}" ;;
  esac
}

parse_args() {
  SELECT_LIST=
  DRY_RUN=0
  YES=0
  ALLOW_REMOTE_INSTALLERS=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --select)
        [[ $# -gt 1 && -n "$2" ]] || fail 'Missing selection'
        SELECT_LIST=$2
        shift
        ;;
      --dry-run) DRY_RUN=1 ;;
      --yes) YES=1 ;;
      --allow-remote-installers) ALLOW_REMOTE_INSTALLERS=1 ;;
      --configs-only) CONFIGS_ONLY=1 ;;
      --pi-merge) PI_MERGE=1 ;;
      *) usage >&2; fail "Unknown option: $1" ;;
    esac
    shift
  done
}

read_arch() {
  printf '%s\n' "${DOTFILES_ARCH:-$(uname -m)}"
}

interactive_selection() {
  local tui_bin=
  if [[ -n ${DOTFILES_TUI_BIN+x} ]]; then
    tui_bin=$DOTFILES_TUI_BIN
    [[ -f "$tui_bin" && -x "$tui_bin" ]] || fail "DOTFILES_TUI_BIN must name an executable file: ${tui_bin:-<empty>}"
  elif [[ -f "$ROOT/tui/bin/dotfiles-tui" && -x "$ROOT/tui/bin/dotfiles-tui" ]]; then
    tui_bin=$ROOT/tui/bin/dotfiles-tui
  fi

  if [[ -n "$tui_bin" ]]; then
    SELECT_LIST=$("$tui_bin" --os "$OS_NAME" --arch "$(read_arch)")
  else
    SELECT_LIST=$(PYTHONDONTWRITEBYTECODE=1 python3 -B "$ROOT/scripts/interactive_menu.py" --os "$OS_NAME" --arch "$(read_arch)")
  fi
  [[ -n "$SELECT_LIST" ]] || { printf 'Cancelled; no changes made.\n'; exit 0; }
}

is_config_id() {
  case "$1" in ghostty|tmux|herdr|starship|zsh|opencode|aerospace) return 0 ;; *) return 1 ;; esac
}
is_shell_tool_id() {
  case "$1" in atuin|zoxide|eza|fnm|zsh-autosuggestions|zsh-syntax-highlighting|neovim) return 0 ;; *) return 1 ;; esac
}

validate_selection() {
  local id seen=
  [[ "$SELECT_LIST" != ,* && "$SELECT_LIST" != *, && "$SELECT_LIST" != *,,* ]] || fail 'Invalid empty selection'
  IFS=, read -r -a SELECTION_IDS <<<"$SELECT_LIST"
  for id in "${SELECTION_IDS[@]}"; do
    is_config_id "$id" || is_shell_tool_id "$id" || [[ "$id" == pi ]] || fail "Unknown selection: $id"
    [[ "$OS_NAME" == Darwin || "$id" != aerospace ]] || fail 'Aerospace is macOS-only'
    case ",$seen," in *,"$id",*) fail 'Duplicate selection' ;; esac
    seen+="${seen:+,}$id"
  done
}

plan_selection() {
  local id tool_selected=0
  APP_SELECT=
  CONFIG_SELECT=
  PI_SELECTED=0
  for id in "${SELECTION_IDS[@]}"; do
    if [[ "$id" == pi ]]; then
      PI_SELECTED=1
    elif is_config_id "$id"; then
      CONFIG_SELECT+="${CONFIG_SELECT:+,}$id"
      (( CONFIGS_ONLY == 1 )) || APP_SELECT+="${APP_SELECT:+,}$id"
    else
      tool_selected=1
      (( CONFIGS_ONLY == 1 )) || APP_SELECT+="${APP_SELECT:+,}$id"
    fi
  done
  if ((CONFIGS_ONLY == 1 && tool_selected == 1 && PI_SELECTED == 0)) && [[ -z "$CONFIG_SELECT" ]]; then
    fail '--configs-only selection contains no configuration targets; remove tool-only IDs or omit --configs-only'
  fi
  (( PI_MERGE == 0 || PI_SELECTED == 1 )) || fail '--pi-merge requires pi in --select'
}

run_pi_setup() {
  local -a args=()
  [[ "$1" == dry-run ]] && args+=(--dry-run)
  (( PI_MERGE == 1 )) && args+=(--merge)
  if ((${#args[@]})); then
    PYTHONDONTWRITEBYTECODE=1 DOTFILES_TEST_OS="$OS_NAME" PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" bash "$ROOT/scripts/setup-pi.sh" "${args[@]}"
  else
    PYTHONDONTWRITEBYTECODE=1 DOTFILES_TEST_OS="$OS_NAME" PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" bash "$ROOT/scripts/setup-pi.sh"
  fi
}

preview() {
  printf '[dotfiles] Preview: applications=%s, configurations=%s\n' "${APP_SELECT:-none}" "${CONFIG_SELECT:-none}"
  if (( PI_SELECTED == 1 )); then
    pi_preflight
    run_pi_setup dry-run || fail 'Pi target validation failed; no applications were installed'
  fi
  if [[ -n "$APP_SELECT" ]]; then
    DOTFILES_TEST_OS="$OS_NAME" DOTFILES_OS_RELEASE="${DOTFILES_OS_RELEASE:-}" DOTFILES_APP_SELECT="${APP_SELECT//,/ }" DOTFILES_DRY_RUN=1 bash "$ROOT/scripts/install-apps.sh" --yes || fail 'Application preview failed; no changes were made'
  fi
  if [[ -n "$CONFIG_SELECT" ]]; then
    DOTFILES_TEST_OS="$OS_NAME" bash "$ROOT/install.sh" --dry-run --select "$CONFIG_SELECT" || fail 'Configuration preview failed; no changes were made'
  fi
}

pi_preflight() {
  local nodev major minor bin
  command -v node >/dev/null 2>&1 || fail 'Missing prerequisite: node'
  command -v python3 >/dev/null 2>&1 || fail 'Missing prerequisite: python3'
  command -v npm >/dev/null 2>&1 || fail 'Missing prerequisite: npm'
  command -v pnpm >/dev/null 2>&1 || fail 'Missing prerequisite: pnpm'
  nodev=$(node --version 2>/dev/null || true)
  [[ "$nodev" =~ ^v([0-9]+)\.([0-9]+)\. ]] || fail 'Node >=22.19.0 is required'
  major=${BASH_REMATCH[1]}; minor=${BASH_REMATCH[2]}
  (( major > 22 || (major == 22 && minor >= 19) )) || fail 'Node >=22.19.0 is required'
  if (( DRY_RUN == 0 )); then
bin=$(pnpm config get global-bin-dir 2>/dev/null || true)
[[ "$bin" == /* && -d "$bin" && -x "$bin" && -w "$bin" ]] || fail 'pnpm global-bin-dir must be an absolute usable directory'
  fi
}

confirm() {
  (( DRY_RUN == 1 || YES == 1 )) && return 0
  [[ -t 0 ]] || fail 'Explicit --yes is required in noninteractive mode'
  printf 'Apply this plan? [y/N] '
  local answer
  IFS= read -r answer || answer=
  case "$answer" in
    y|Y) ;;
    *) printf 'Cancelled; no changes made.\n'; exit 0 ;;
  esac
}

main() {
  [[ ${1:-} == setup ]] || { usage >&2; exit 1; }
  shift
  CONFIGS_ONLY=0
  PI_MERGE=0
  parse_args "$@"
  OS_NAME=$(read_os)
  validate_os "$OS_NAME"
  if [[ "$OS_NAME" == Linux ]]; then
    validate_linux_distribution
  fi
  if [[ -z "$SELECT_LIST" ]]; then
    [[ -t 0 ]] || fail 'Interactive selection requires a TTY; use --select LIST'
    interactive_selection
  fi
  validate_selection
  plan_selection
  preview
  (( DRY_RUN == 0 )) || exit 0
  confirm

  if [[ -n "$APP_SELECT" ]]; then
    local -a install_args=(--yes)
    (( ALLOW_REMOTE_INSTALLERS == 1 )) && install_args+=(--allow-remote-installers)
    DOTFILES_TEST_OS="$OS_NAME" DOTFILES_OS_RELEASE="${DOTFILES_OS_RELEASE:-}" DOTFILES_APP_SELECT="${APP_SELECT//,/ }" bash "$ROOT/scripts/install-apps.sh" "${install_args[@]}" || fail 'Application installation failed; no configuration links were changed'
  fi
  if (( PI_SELECTED == 1 )); then
    run_pi_setup apply || fail 'Pi setup failed; configuration links were not changed'
  fi
  if [[ -n "$CONFIG_SELECT" ]]; then
    DOTFILES_TEST_OS="$OS_NAME" exec bash "$ROOT/install.sh" --select "$CONFIG_SELECT"
  fi
  printf '[dotfiles] Done; no configuration links selected.\n'
}

main "$@"
